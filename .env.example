# H2SENSE Configuration Environment Variables
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-random-secret-key

# Database Configuration (MySQL / WAMP Server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=h2sense
DB_USER=root
DB_PASSWORD=

# Environmental Sensor Correction Baseline
TEMP_BASELINE=25.0
TEMP_COEFFICIENT=0.35
HUMIDITY_BASELINE=50.0
HUMIDITY_COEFFICIENT=0.15

# Threshold Configuration (Units / Prototype PPM scale)
THRESHOLD_SAFE=25.0
THRESHOLD_CAUTION=50.0
THRESHOLD_HIGH=100.0
